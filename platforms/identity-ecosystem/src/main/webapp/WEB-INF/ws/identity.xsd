<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://enterpriseecosystem.com/identity/ws"
           targetNamespace="http://enterpriseecosystem.com/identity/ws"
           elementFormDefault="qualified">

  <xs:element name="CreateUserRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="email" type="xs:string"/>
        <xs:element name="displayName" type="xs:string"/>
        <xs:element name="password" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="CreateUserResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="publicId" type="xs:string"/>
        <xs:element name="email" type="xs:string"/>
        <xs:element name="displayName" type="xs:string"/>
        <xs:element name="status" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ChangeUserStateRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="publicId" type="xs:string"/>
        <xs:element name="status" type="tns:UserStatus"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ChangeUserStateResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="publicId" type="xs:string"/>
        <xs:element name="status" type="tns:UserStatus"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetCurrentUserRequest">
    <xs:complexType>
      <xs:sequence/>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetCurrentUserResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="publicId" type="xs:string"/>
        <xs:element name="email" type="xs:string"/>
        <xs:element name="displayName" type="xs:string"/>
        <xs:element name="status" type="tns:UserStatus"/>
        <xs:element name="authorities" type="tns:Authorities"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Authorities">
    <xs:sequence>
      <xs:element name="authority" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="UserStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACTIVE"/>
      <xs:enumeration value="SUSPENDED"/>
      <xs:enumeration value="LOCKED"/>
      <xs:enumeration value="INACTIVE"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
